# ResumeAI Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (leave blank to use auto embedded in-memory database)
# Example local: mongodb://127.0.0.1:27017/resume_ai
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/resume_ai?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/resume_ai

# JWT Secret & Expiry
JWT_SECRET=resume_ai_super_secret_jwt_key_2026_btech_project
JWT_EXPIRES_IN=30d

# Optional External LLM API Key (Google Gemini)
# Leave blank or commented out to use high-accuracy built-in rule-based ATS engine
GEMINI_API_KEY=
